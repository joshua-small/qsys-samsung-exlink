-- Samsung consumer ExLink - Joshua Small - 10/2026
-- Based on Samsung-RS232-Control.pdf. No device-state queries are documented.
PluginInfo = {
  Name = "Samsung~Consumer ExLink",
  Version = "1.1.0.3",
  BuildVersion = "1.1.0.3",
  Id = "053da5a0-922c-4d94-a662-5241818076d6",
  Author = "Joshua Small",
  Manufacturer = "Samsung",
  Model = "Consumer ExLink",
  Description = "Consumer ExLink over Serial or optional raw TCP, including Frame Art Mode. Command-only state; model-dependent TCP support.",
}

--*** Command definitions: Cmd1, Cmd2, Cmd3, Value ***
CommandDefinitions = {
  { "PowerOn", "Power On", "Power", { 0x00, 0x00, 0x00, 0x02 }, true },
