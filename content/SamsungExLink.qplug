--*** Runtime ***
-- Host connection API used below; Open/Close/IsOpen are serial-only,
-- Connect/Disconnect/IsConnected are TCP-only. UseTcp selects the valid API.
---@class ExLinkConnection
---@field IsOpen boolean
---@field IsConnected boolean
---@field BufferLength integer
---@field Read fun(self: ExLinkConnection, count: integer): string|nil
---@field Write fun(self: ExLinkConnection, data: string): string|nil
---@field Open fun(self: ExLinkConnection, baud: integer, bits: integer, parity: string, stop: integer)
---@field Close fun(self: ExLinkConnection)
---@field Connect fun(self: ExLinkConnection, address: string, port: integer)
---@field Disconnect fun(self: ExLinkConnection)
---@field Connected fun(port: ExLinkConnection)
---@field Data fun(port: ExLinkConnection)
---@field Closed fun(port: ExLinkConnection)
---@field Error fun(port: ExLinkConnection, err: string)
---@field Timeout fun(port: ExLinkConnection)
---@field Reconnect fun(port: ExLinkConnection)
---@field ReadTimeout number
---@field WriteTimeout number
---@field ReconnectTimeout number
if Controls then
  --*** Runtime state ***
  UseTcp = Properties["Connection Type"].Value == "TCP"
  TransportName = UseTcp and "TCP" or "Serial"
  ---@type ExLinkConnection|nil
  Port = not UseTcp and SerialPorts and SerialPorts[1] or nil
  TcpReady = false
  TcpConnecting = false
  Queue = {}
  Pending = nil
  RxBuffer = ""
  Cooling = false
  Faulted = false
  Initializing = false
  SuccessReplies = 0
  --*** Host objects ***
  GapTimer = Timer.New()
  ReplyTimer = Timer.New()
  FreshnessTimer = Timer.New()
  OpenTimer = Timer.New()
  ConnectTimer = Timer.New()
  --*** Protocol and configuration constants ***
  ProtocolHeader = { 0x08, 0x22 }
  SuccessReply = string.char(0x03, 0x0C, 0xF1)
  QueueLimit = 32
  ReceiveDisplayLimit = 64
  SuccessFreshness = 10
  WaitForSuccess = Properties["Reply Handling"].Value == "Wait for success"
  CommandInterval = Properties["Command Interval"].Value
  PowerOnDelay = Properties["Power On Delay"].Value
  ReplyTimeout = Properties["Reply Timeout"].Value
  ConnectTimeout = 10

  --*** Debug configuration ***
  function SetupDebugPrint()
    local selection = Properties["Debug Print"].Value
    DebugAll = selection == "All"
    DebugTx = DebugAll or selection == "Tx" or selection == "Tx/Rx"
    DebugRx = DebugAll or selection == "Rx" or selection == "Tx/Rx"
    DebugFunction = DebugAll or selection == "Function Calls"
  end

  function TraceFunction(name)
    if DebugFunction then
      print("ExLink function: " .. name)
    end
  end

  --*** Runtime functions ***
  function TransportReady()
    if not Port then
      return false
    end
    if UseTcp then
      return TcpReady and Port.IsConnected == true
    end
    return Port.IsOpen == true
  end

  function SetStatus(value, message)
    Controls.Status.Value = value
    Controls.Status.String = message
  end

  function Hex(data)
    local bytes = {}
    for index = 1, #data do
      bytes[index] = string.format("%02X", data:byte(index))
    end
    return table.concat(bytes, " ")
  end

  function Encode(command)
    if type(command) ~= "table" or #command ~= 4 then
      return nil
    end
    local sum = ProtocolHeader[1] + ProtocolHeader[2]
    for _, value in ipairs(command) do
      if type(value) ~= "number" or value ~= math.floor(value) or value < 0 or value > 255 then
        return nil
      end
      sum = sum + value
    end
    return string.char(
      ProtocolHeader[1],
      ProtocolHeader[2],
      command[1],
      command[2],
      command[3],
      command[4],
      -sum % 256
    )
  end

  function UpdateQueue()
    Controls.QueueDepth.String = tostring(#Queue)
    Controls.Busy.Boolean = Pending ~= nil or Cooling or #Queue > 0
    Controls.SerialOpen.Boolean = not UseTcp and Port ~= nil and Port.IsOpen == true
    Controls.TCPConnected.Boolean = UseTcp and Port ~= nil and Port.IsConnected == true
  end

  function ResetTransactions()
    TraceFunction("ResetTransactions")
    Queue = {}
    Pending = nil
    RxBuffer = ""
    Cooling = false
    GapTimer:Stop()
    ReplyTimer:Stop()
    FreshnessTimer:Stop()
    UpdateQueue()
  end

  function Fail(message)
    TraceFunction("Fail")
    TcpConnecting = false
    ConnectTimer:Stop()
    ResetTransactions()
    Faulted = true
    SetStatus(2, message .. "; reconnect to continue")
    Controls.LastResponse.String = message
    print("ExLink: " .. message)
  end

  function Pump()
    TraceFunction("Pump")
    if Initializing or Faulted or Cooling or Pending or #Queue == 0 then
      UpdateQueue()
      return
    end
    if not Port or not TransportReady() then
      Fail(TransportName .. " connection unavailable")
      return
    end
    local item = table.remove(Queue, 1)
    -- Clear bytes received before this transmission; acknowledgements carry no command ID.
    local readOk, readError = pcall(function()
      if Port.BufferLength > 0 then
        Port:Read(Port.BufferLength)
      end
    end)
    if not readOk then
      Fail(TransportName .. " read error: " .. tostring(readError))
      return
    end
    RxBuffer = ""
    Cooling = true
    if WaitForSuccess then
      Pending = item
      ReplyTimer:Start(item.Wake and math.max(ReplyTimeout, PowerOnDelay) or ReplyTimeout)
    end
    GapTimer:Start(item.Wake and math.max(CommandInterval, PowerOnDelay) or CommandInterval)
    local ok, err = pcall(function()
      return Port:Write(item.Bytes)
    end)
    if not ok or err then
      Fail(TransportName .. " write error: " .. tostring(err))
      return
    end
    Controls.LastCommand.String = item.Label
    Controls.LastTx.String = Hex(item.Bytes)
    if DebugTx then
      print("ExLink TX " .. Controls.LastTx.String .. " (" .. item.Label .. ")")
    end
    SetStatus(
      3,
      WaitForSuccess and "Sent; waiting for generic success reply" or "Sent; TV state unavailable"
    )
    UpdateQueue()
  end

  function Enqueue(label, command, wake, coalesce)
    TraceFunction("Enqueue")
    local bytes = Encode(command)
    if not bytes then
      Controls.LastResponse.String = "Invalid command rejected"
      return
    end
    if Initializing or Faulted or not TransportReady() then
      Controls.LastResponse.String = "Command not sent: "
        .. TransportName
        .. " not ready; reconnect if needed"
      return
    end
    -- Coalesce only adjacent unsent volume targets; preserve power/input ordering.
    if coalesce and #Queue > 0 and Queue[#Queue].Coalesce == coalesce then
      Queue[#Queue] = { Label = label, Bytes = bytes, Wake = wake, Coalesce = coalesce }
    elseif #Queue >= QueueLimit then
      Controls.LastResponse.String = "Command not queued: queue is full (32)"
      return
    else
      table.insert(Queue, { Label = label, Bytes = bytes, Wake = wake, Coalesce = coalesce })
    end
    Pump()
  end

  function SendKey(name)
    TraceFunction("SendKey")
    for _, key in ipairs(KeyDefinitions) do
      if name == key[1] then
        Enqueue("Key: " .. name, { 0x0D, 0, 0, key[2] })
        return
      end
    end
    Controls.LastResponse.String = "Unknown remote key; choose a listed key"
  end

  function Receive(port)
    TraceFunction("Receive")
    local ok, data = pcall(function()
      if port.BufferLength == 0 then
        return nil
      end
      return port:Read(port.BufferLength)
    end)
    if not ok then
      Fail(TransportName .. " read error: " .. tostring(data))
      return
    end
    if not data or #data == 0 then
      return
    end
    Controls.LastRx.String = Hex(data:sub(-ReceiveDisplayLimit))
    if DebugRx then
      print("ExLink RX " .. Controls.LastRx.String)
    end
    -- Retain at most two partial bytes between callbacks, including on noisy streams.
    local combined = RxBuffer .. data
    local cursor = 1
    local observed = false
    while true do
      local first, last = combined:find(SuccessReply, cursor, true)
      if not first then
        break
      end
      SuccessReplies = SuccessReplies + 1
      observed = true
      cursor = last + 1
    end
    RxBuffer = combined:sub(cursor):sub(-2)
    if observed then
      Controls.SuccessCount.String = tostring(SuccessReplies)
      Controls.LastResponse.String = "Generic success reply observed; TV state unavailable"
      if not Faulted and not Initializing then
        Pending = nil
        ReplyTimer:Stop()
        SetStatus(0, "Success reply observed; TV state unavailable")
        FreshnessTimer:Start(SuccessFreshness)
      end
    else
      Controls.LastResponse.String = "Received bytes; no complete documented success reply"
    end
    -- Parse the entire callback before permitting the next queued transaction.
    Pump()
  end

  function Connected()
    TraceFunction("Connected")
    if Initializing or (UseTcp and (not TcpConnecting or not Port or not Port.IsConnected)) then
      return
    end
    ConnectTimer:Stop()
    TcpConnecting = false
    TcpReady = UseTcp
    ResetTransactions()
    Faulted = false
    SetStatus(3, TransportName .. " ready; TV communication unverified")
    print(UseTcp and "ExLink: TCP connected" or "ExLink: serial port open")
  end

  function BindTransportCallbacks()
    if not Port then
      return
    end
    Port.Connected = function(port)
      if port == Port and not Initializing then
        Connected()
      end
    end
    Port.Data = function(port)
      if port == Port and not Initializing then
        Receive(port)
      end
    end
    Port.Closed = function(port)
      if port == Port and not Initializing then
        ConnectTimer:Stop()
        TcpReady = false
        Fail(TransportName .. " connection closed")
      end
    end
    Port.Error = function(port, err)
      if port == Port and not Initializing then
        ConnectTimer:Stop()
        TcpReady = false
        Fail(TransportName .. " error: " .. tostring(err))
      end
    end
    Port.Timeout = function(port)
      if port == Port and not Initializing then
        ConnectTimer:Stop()
        TcpReady = false
        Fail(TransportName .. " transport timeout")
      end
    end
    Port.Reconnect = function(port)
      if port == Port and not Initializing then
        TcpReady = false
        Fail(TransportName .. " transport reconnecting")
      end
    end
  end

  function Initialize()
    TraceFunction("Initialize")
    Initializing = true
    TcpReady = false
    TcpConnecting = false
    ResetTransactions()
    Faulted = false
    OpenTimer:Stop()
    ConnectTimer:Stop()
    -- Retire the previous TCP object before disconnecting so late callbacks
    -- cannot clear a fault or affect a new connection attempt.
    local previous = Port or (not UseTcp and SerialPorts and SerialPorts[1])
    Port = nil
    local ok, err = pcall(function()
      if previous then
        if UseTcp then
          previous:Disconnect()
        elseif previous.IsOpen then
          previous:Close()
        end
      end
    end)
    if not ok then
      Initializing = false
      Fail(TransportName .. " close error: " .. tostring(err))
      return
    end
    if UseTcp then
      TcpAddress = Properties["TCP Address"].Value:match("^%s*(.-)%s*$")
      TcpPort = Properties["TCP Port"].Value
      Controls.Configuration.String = "TCP "
        .. TcpAddress
        .. ":"
        .. tostring(TcpPort)
        .. " | "
        .. Properties["Reply Handling"].Value
      if TcpAddress == "" or TcpAddress:find("%s") then
        Initializing = false
        SetStatus(2, "Enter a TCP address or hostname in Properties")
        UpdateQueue()
        return
      end
      if
        type(TcpPort) ~= "number"
        or TcpPort ~= math.floor(TcpPort)
        or TcpPort < 1
        or TcpPort > 65535
      then
        Initializing = false
        SetStatus(2, "TCP port must be an integer from 1 to 65535")
        UpdateQueue()
        return
      end
      Port = TcpSocket.New()
      Port.ReadTimeout = 0 -- No unsolicited data or polling is required.
      Port.WriteTimeout = 0 -- Command-only traffic can remain idle indefinitely.
      Port.ReconnectTimeout = 0 -- Explicit reconnect; never replay commands after a fault.
    else
      Port = SerialPorts and SerialPorts[1]
    end
    if not Port then
      Initializing = false
      SetStatus(3, "Wire Serial to a Q-SYS port; serial requires a Core")
      return
    end
    BindTransportCallbacks()
    SetStatus(5, "Opening " .. TransportName .. "; queued commands cleared")
    -- Delay also allows virtual serial server connections to settle.
    OpenTimer:Start(1)
    UpdateQueue()
  end

  --*** Event handlers ***
  GapTimer.EventHandler = function()
    GapTimer:Stop()
    Cooling = false
    Pump()
  end
  ReplyTimer.EventHandler = function()
    ReplyTimer:Stop()
    if Pending then
      Fail("No success reply; outcome unknown, queue cleared")
    end
  end
  FreshnessTimer.EventHandler = function()
    FreshnessTimer:Stop()
    if not Faulted and not Initializing then
      SetStatus(3, TransportName .. " ready; no recent success reply / no state polling")
    end
  end
  OpenTimer.EventHandler = function()
    OpenTimer:Stop()
    Initializing = false
    if not Port then
      Fail(TransportName .. " connection unavailable")
      return
    end
    local ok, err = pcall(function()
      if UseTcp then
        TcpConnecting = true
        ConnectTimer:Start(ConnectTimeout)
        Port:Connect(TcpAddress, TcpPort)
      else
        local baud = tonumber(Properties["Baud Rate"].Value)
        if not baud then
          error("Invalid baud rate")
        end
        Port:Open(math.floor(baud), 8, "N", 1)
      end
    end)
    if not ok then
      ConnectTimer:Stop()
      Fail(TransportName .. " open error: " .. tostring(err))
    elseif not UseTcp and Port.IsOpen then
      Connected()
    end
  end
  ConnectTimer.EventHandler = function()
    ConnectTimer:Stop()
    local previous = Port
    Port = nil
    TcpReady = false
    if previous then
      pcall(function()
        previous:Disconnect()
      end)
    end
    Fail("TCP connection timed out")
  end
  for _, command in ipairs(CommandDefinitions) do
    Controls[command[1]].EventHandler = function()
      Enqueue(command[2], command[4], command[5])
    end
  end
  for _, key in ipairs(RemoteButtons) do
    Controls["Key" .. key[1]].EventHandler = function()
      SendKey(key[2])
    end
  end
  for digit = 0, 9 do
    Controls["Digit" .. digit].EventHandler = function()
      SendKey(tostring(digit))
    end
  end
  Controls.VolumeSet.EventHandler = function(control)
    local value = control.Value
    if type(value) ~= "number" or value ~= value or value < 0 or value > 100 then
      Controls.LastResponse.String = "Volume rejected: use 0-100"
      return
    end
    value = math.floor(value + 0.5)
    Enqueue("Volume set: " .. value, { 0x01, 0, 0, value }, false, "Volume")
  end
  Controls.SendInput.EventHandler = function()
    for _, input in ipairs(InputDefinitions) do
      if input[1] == Controls.InputSelect.String then
        Enqueue("Input: " .. input[1], { 0x0A, 0, input[2], input[3] })
        return
      end
    end
    Controls.LastResponse.String = "Unknown input; choose a listed input"
  end
  Controls.SendKey.EventHandler = function()
    SendKey(Controls.KeySelect.String)
  end
  Controls.ApplyPicture.EventHandler = function()
    for index, name in ipairs(PictureModes) do
      if name == Controls.PictureMode.String then
        Enqueue("Picture: " .. name, { 0x0B, 0, 0, index - 1 })
        return
      end
    end
    Controls.LastResponse.String = "Unknown picture mode"
  end
  Controls.ApplySound.EventHandler = function()
    for index, name in ipairs(SoundModes) do
      if name == Controls.SoundMode.String then
        Enqueue("Sound: " .. name, { 0x0C, 0, 0, index })
        return
      end
    end
    Controls.LastResponse.String = "Unknown sound mode"
  end
  Controls.Reconnect.EventHandler = Initialize
  Controls.ClearQueue.EventHandler = function()
    Queue = {}
    UpdateQueue()
    Controls.LastResponse.String = "Unsent queue cleared; any transmitted command remains in flight"
  end
  --*** Initialization ***
  InputChoices = {}
  for _, input in ipairs(InputDefinitions) do
    table.insert(InputChoices, input[1])
  end
  Controls.InputSelect.Choices = InputChoices
  KeyChoices = {}
  for _, key in ipairs(KeyDefinitions) do
    table.insert(KeyChoices, key[1])
  end
  Controls.KeySelect.Choices = KeyChoices
  Controls.PictureMode.Choices = PictureModes
  Controls.SoundMode.Choices = SoundModes
  Controls.LastCommand.String = "No command sent"
  Controls.LastTx.String = ""
  Controls.LastRx.String = ""
  Controls.LastResponse.String = "No response observed"
  Controls.SuccessCount.String = "0"
  Controls.Configuration.String = Properties["Baud Rate"].Value
    .. " 8N1 | "
    .. Properties["Reply Handling"].Value
    .. " | "
    .. CommandInterval
    .. "s spacing | "
    .. PowerOnDelay
    .. "s power delay"
  SetupDebugPrint()
  print("Samsung ExLink " .. PluginInfo.Version .. " starting")
  Initialize()
end
