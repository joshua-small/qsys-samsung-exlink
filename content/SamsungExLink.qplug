--*** Reserved design-time functions ***
function GetColor(props)
  return SamsungBlue
end

function GetPrettyName(props)
  return "Samsung ExLink " .. PluginInfo.Version
end

function GetProperties()
  return {
    {
      Name = "Connection Type",
      Type = "enum",
      Choices = { "Serial", "TCP" },
      Value = "Serial",
    },
    {
      Name = "TCP Address",
      Type = "string",
      Value = "",
    },
    {
      Name = "TCP Port",
      Type = "integer",
      Min = 1,
      Max = 65535,
      Value = 1515,
    },
    {
      Name = "Baud Rate",
      Type = "enum",
      Choices = { "9600", "19200", "38400", "57600", "115200" },
      Value = "9600",
    },
    {
      Name = "Reply Handling",
      Type = "enum",
      Choices = { "Monitor only", "Wait for success" },
      Value = "Monitor only",
    },
    {
      Name = "Command Interval",
      Type = "double",
      Min = 0.1,
      Max = 5,
      Value = 0.3,
    },
    {
      Name = "Power On Delay",
      Type = "double",
      Min = 1,
      Max = 60,
      Value = 5,
    },
    {
      Name = "Reply Timeout",
      Type = "double",
      Min = 0.5,
      Max = 30,
      Value = 2,
    },
    {
      Name = "Debug Print",
      Type = "enum",
      Choices = { "None", "Tx", "Rx", "Tx/Rx", "Function Calls", "All" },
      Value = "None",
    },
  }
end

function RectifyProperties(props)
  local useTcp = props["Connection Type"].Value == "TCP"
  props["Baud Rate"].IsHidden = useTcp
  props["TCP Address"].IsHidden = not useTcp
  props["TCP Port"].IsHidden = not useTcp
  props["Reply Timeout"].IsHidden = props["Reply Handling"].Value ~= "Wait for success"
  if props.plugin_show_debug then
    props["Debug Print"].IsHidden = not props.plugin_show_debug.Value
  end
  return props
end

function GetPages(props)
  return { { name = "Setup" }, { name = "Controls" }, { name = "Remote" } }
end

function GetPins(props)
  if props["Connection Type"].Value == "TCP" then
    return {}
  end
  return {
    {
      Name = "Serial",
      Direction = "input",
      Domain = "serial",
    },
  }
end

