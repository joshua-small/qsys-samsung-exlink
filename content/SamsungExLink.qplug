function GetControlLayout(props)
  local page = props.page_index and props.page_index.Value or 1
  local layout
  local graphics
  if page == 2 then
    layout, graphics = GetControlPage()
  elseif page == 3 then
    layout, graphics = GetRemotePage()
  else
    layout, graphics = GetSetupPage(props)
  end
  for name, prettyName in pairs(ControlPinNames) do
    if not layout[name] then
      layout[name] = { Style = "None", Position = { 0, 0 }, Size = { 1, 1 }, ZOrder = 2000 }
    end
    layout[name].PrettyName = prettyName
  end
  return layout, graphics
end

--*** Direct native page definitions ***
