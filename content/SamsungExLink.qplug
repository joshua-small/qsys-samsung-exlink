InputDefinitions = { { "TV", 0, 0 } }
for _, family in ipairs({
  { "AV", 1, 3 },
  { "S-Video", 2, 3 },
  { "Component", 3, 3 },
  { "PC", 4, 3 },
  { "HDMI", 5, 4 },
  { "DVI", 6, 3 },
}) do
  for index = 1, family[3] do
    table.insert(InputDefinitions, { family[1] .. " " .. index, family[2], index - 1 })
  end
end
table.insert(InputDefinitions, { "RVU", 7, 0 })
PictureModes =
  { "Dynamic", "Standard", "Movie", "Natural", "CAL-NIGHT", "CAL-DAY", "BD Wise", "Relax" }
